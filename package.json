{
  "name": "vitality-gym",
  "version": "1.0.0",
  "description": "Sistema de Control de Membresías y Acceso - Gimnasio Vitality",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "db:create": "mysql -u root -p < database/sql/01_schema.sql",
    "db:triggers": "mysql -u root -p < database/sql/02_triggers.sql",
    "db:views": "mysql -u root -p < database/sql/03_vistas.sql",
    "db:permissions": "mysql -u root -p < database/sql/04_usuarios_permisos.sql",
    "db:seed": "mysql -u vitality_app -pVitality2024! < database/sql/05_datos_iniciales.sql",
    "db:setup": "npm run db:create && npm run db:triggers && npm run db:views && npm run db:permissions && npm run db:seed",
    "db:reset": "echo 'DROP DATABASE IF EXISTS vitality_gym;' | mysql -u root -p && npm run db:setup",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "gym",
    "membership",
    "mysql",
    "nodejs",
    "express",
    "bootstrap"
  ],
  "author": "Daniela Blandón, Jhon Hucker Chalarca",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
